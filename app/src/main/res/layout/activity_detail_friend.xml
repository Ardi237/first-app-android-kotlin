<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@android:color/white">

    <!-- Input Nama -->
    <EditText
        android:id="@+id/etDetailName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nama Teman"
        android:textColorHint="#808080"
        android:textColor="@android:color/black"
        android:backgroundTint="@android:color/white"
        android:padding="16dp"
        android:background="@drawable/edit_text_background"/>

    <!-- Input Tanggal Lahir -->
    <EditText
        android:id="@+id/etDetailBirthDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Tanggal Lahir (YYYY-MM-DD)"
        android:focusable="false"
        android:clickable="true"
        android:textColorHint="#808080"
        android:textColor="@android:color/black"
        android:padding="16dp"
        android:background="@drawable/edit_text_background"/>

    <!-- Preview Gambar -->
    <ImageView
        android:id="@+id/ivDetailFriendImage"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:scaleType="centerCrop"
        android:background="@android:color/darker_gray"/>

    <!-- Tombol Pilih Gambar Baru -->
    <Button
        android:id="@+id/btnEditImage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Pilih atau Ubah Gambar"
        android:textColor="@android:color/white"
        android:backgroundTint="@android:color/holo_orange_dark"/>

    <!-- Tombol Update dan Delete -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btnUpdateFriend"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Update"
            android:layout_marginEnd="8dp"
            android:textColor="@android:color/white"
            android:backgroundTint="@android:color/holo_green_dark"/>

        <Button
            android:id="@+id/btnDeleteFriend"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Delete"
            android:layout_marginStart="8dp"
            android:textColor="@android:color/white"
            android:backgroundTint="@android:color/holo_red_dark"/>
    </LinearLayout>

</LinearLayout>